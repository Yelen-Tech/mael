# ---------- Django ----------
SECRET_KEY=change-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Base de donnees ----------
DATABASE_URL=postgres://sentinelle:sentinelle@localhost:5432/sentinelle

# ---------- Cache et file d'attente ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Cerveau (section 02 du plan) ----------
# ollama | llamacpp | vllm
BRAIN_BACKEND=ollama
BRAIN_BASE_URL=http://localhost:11434
BRAIN_MODEL_TRI=qwen3:8b
BRAIN_MODEL_ANALYSTE=qwen3:30b-a3b
BRAIN_TIMEOUT=120
# Grand modele (BRAIN_BACKEND=vllm) : installe sur CETTE machine (cartes
# graphiques) et lance a cote avec `vllm serve <modele>`. Rien ne sort.
# BRAIN_VLLM_URL=http://127.0.0.1:8000
# BRAIN_VLLM_MODELE=
# BRAIN_VLLM_CONTEXTE=65536
# BRAIN_VLLM_MILLIARDS=0

# ---------- Flux de renseignement ----------
ABUSEIPDB_KEY=
OTX_KEY=

# ---------- Execution des outils ----------
# docker | local  -- docker est le seul mode sur pour la production
TOOL_RUNTIME=docker
TOOL_TIMEOUT=300
