# Banc d'essai MAEL — Debian 12 (bookworm)
# Empreinte figee par resoudre_empreintes.py (jamais :latest implicite).
FROM debian:12@sha256:f37a335e82bca302e955fa39f9dfe28f1be618f016f8a2b56318e5a5111afc26

ENV DEBIAN_FRONTEND=noninteractive

# Jeu representatif d'un serveur : SSH, journaux, audit, privileges,
# planification, pare-feu. systemd est installe mais ne tourne PAS en
# conteneur (PID 1 = sleep) : les controles systemctl/noyau sont marques
# « a tester en VM » par le banc, pas juges faux.
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server openssh-client \
        rsyslog auditd \
        sudo cron \
        nftables \
        openssl ca-certificates \
        apparmor apparmor-utils \
        procps findutils gawk iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    # sshd -T exige /run/sshd, cree par systemd sur une vraie machine
    # (banc reel 19/09/2026 : 24 fiches SSH restaient indeterminees).
    && mkdir -p /run/sshd

CMD ["sleep", "infinity"]
